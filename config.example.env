CPANEL_BASE_URL=https://cpanel.example.com:2083
CPANEL_USERNAME=cpanel-user
CPANEL_PASSWORD=replace-with-cpanel-password
CPANEL_API_TOKEN=

CPANEL_FTP_HOST=cpanel.example.com
CPANEL_FTP_PORT=21
CPANEL_FTP_USERNAME=cpanel-user
CPANEL_FTP_PASSWORD=replace-with-ftp-password
CPANEL_FTP_BACKUP_DIR=

BACKUP_DIR=/backups
CPANEL_INCLUDE_HOME=true
DELETE_REMOTE_AFTER_DOWNLOAD=true
VERIFY_ARCHIVE=true
EXPECTED_ARCHIVE_ENTRIES=homedir/public_html,mysql/example_database.sql

POLL_INTERVAL_SECS=60
BACKUP_TIMEOUT_SECS=7200
RETENTION_KEEP_LAST=7

RUN_MODE=once
SCHEDULE_INTERVAL_SECS=86400
